# Many other options are described here: https://readmedium.com/using-ssh-every-day-explore-advanced-features-to-simplify-your-routine-94b32e953662

Include ~/.orbstack/ssh/config

Host *
  AddKeysToAgent yes
  # AllowTcpForwarding yes
  Compression yes
  ConnectionAttempts 3
  ForwardAgent yes
  IdentitiesOnly yes
  IgnoreUnknown UseKeychain
  ServerAliveCountMax 120
  ServerAliveInterval 30
  StrictHostKeyChecking no
  TCPKeepAlive yes
  UseKeychain yes

Include ~/.ssh/config.local

# CodeWhisperer ssh integration. Keep at the bottom of this file.
Match all
  Include ~/Library/Application Support/codewhisperer/ssh
